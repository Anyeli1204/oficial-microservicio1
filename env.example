# 🌐 Configuración API
BASE_URL=http://your-server-ip:8081/api/v1

# 🗄️ Configuración BD
DB_PASSWORD=your_secure_password_here

# 🔑 Configuración JWT
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_must_be_at_least_32_characters

# 📧 Configuración de Correo
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_app_password_here

# 🌍 Orígenecs permitidos para CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com
