# Variables de entorno para AWS Production

# Base de datos PostgreSQL en AWS RDS
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=scrapetok_accounts
DB_USER=postgres
DB_PASSWORD=your-secure-password

# JWT Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-here-256-bits-minimum
JWT_EXPIRATION=86400000

# Email Configuration (Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-admin-panel.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Logging
LOG_LEVEL=INFO
